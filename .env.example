# Read by `docker compose`, which looks for .env beside the compose file.
# Copy this to .env and fill it in. .env is gitignored.
#
# Running the backend directly instead? That reads Backend/.env —
# see Backend/.env.example for the full list.

APP_NAME=Caelum
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # must be false in production: it controls
                                 # whether stack traces reach the client

# ---------- database ----------
POSTGRES_USER=caelum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caelum
POSTGRES_HOST=localhost          # "db" under docker compose
POSTGRES_PORT=5432
POSTGRES_DRIVER=psycopg          # psycopg (v3, default) | psycopg2

# ---------- auth ----------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# The refresh token is an httpOnly cookie. COOKIE_SECURE must be true behind
# HTTPS, and must be true whenever COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------- web ----------
# Explicit origins: "*" with credentials is rejected by browsers.
CORS_ORIGINS=http://localhost:5173
VITE_BACKEND_URL=http://localhost:8000

# ---------- business ----------
TIMEZONE=Asia/Kolkata
