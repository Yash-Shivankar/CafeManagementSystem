# Copy to .env and fill in. Never commit .env.

APP_NAME=Caelum
DEBUG=True
# development | staging | production
# production also disables /docs, /redoc and /openapi.json
ENVIRONMENT=development

# --- Database ---------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caelum
# psycopg (v3, the maintained one and the default) | psycopg2.
# The project used to install both, so which one ran depended on this URL
# rather than on a decision. It is one line to revert if v3 ever surprises you.
POSTGRES_DRIVER=psycopg
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT --------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-64-byte-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS -------------------------------------------------------------
# Comma separated. Must NOT be "*" — wildcard origins and credentials
# cannot be combined (S-06).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Cookies ----------------------------------------------------------
# COOKIE_SECURE must be True in any environment served over HTTPS.
REFRESH_COOKIE_NAME=caelum_refresh
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# --- Login throttling (S-08) -----------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Locale -----------------------------------------------------------
# Timestamps are stored as UTC; this is the zone a business day is measured in.
TIMEZONE=Asia/Kolkata

# --- Media ------------------------------------------------------------
# How long a signed media URL stays valid, in seconds.
MEDIA_URL_EXPIRE_SECONDS=300
